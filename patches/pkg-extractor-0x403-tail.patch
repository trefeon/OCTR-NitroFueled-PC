+namespace {
+// Reads one 32-byte PKG table entry and range-checks its payload before any
+// caller seeks into it or sizes a buffer from it. Rejects short reads and
+// entry ranges outside the file so truncated headers cannot drive OOB access.
+bool ReadTableEntry(const Common::FS::IOFile& file, PKGEntry& entry,
+                     std::string& failreason) {
+    if (file.Read(entry.id) != 1 || file.Read(entry.filename_offset) != 1 ||
+        file.Read(entry.flags1) != 1 || file.Read(entry.flags2) != 1 ||
+        file.Read(entry.offset) != 1 || file.Read(entry.size) != 1 ||
+        !file.Seek(8, Common::FS::SeekOrigin::CurrentPosition)) {
+        failreason = "PKG table entry is truncated";
+        return false;
+    }
+    const u64 entry_offset = entry.offset;
+    const u64 entry_size = entry.size;
+    if (entry_offset > file.GetSize() || entry_size > file.GetSize() - entry_offset) {
+        failreason = "PKG entry range is outside the file";
+        return false;
+    }
+    return true;
+}
+
+bool ValidateTableRange(const PKGHeader& header, u64 file_size, std::string& failreason) {
+    const u64 table_offset = header.pkg_table_entry_offset;
+    const u64 table_count = header.pkg_table_entry_count;
+    if (table_count > std::numeric_limits<u64>::max() / sizeof(PKGEntry) ||
+        table_offset > file_size ||
+        table_count * sizeof(PKGEntry) > file_size - table_offset) {
+        failreason = "PKG table entry range is outside the file";
+        return false;
+    }
+    return true;
+}
